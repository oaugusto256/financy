DATABASE_URL="file:./dev.db"
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Required — no default. One of: development, test, production. It decides
# whether introspection is served and whether errors carry a stack trace.
NODE_ENV=development
# Rate limiting, all optional — the values below are the defaults.
# The first pair bounds one IP across the whole GraphQL endpoint. The second
# bounds sign-in and sign-up attempts per submitted e-mail address, which is
# what a credential-stuffing run spends: a per-IP limit alone is defeated by
# spreading one guess per address across many hosts.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Password for the seed user (prisma/seed.ts). Development-only; do not set in
# any deployed environment.
SEED_PASSWORD=trocar-esta-senha
